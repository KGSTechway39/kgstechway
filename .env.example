# Copy to .env for local dev. Never commit real values.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# --- Internship application flow (api/apply.js, api/fee-preference.js) ---
# Gmail account that sends the greeting email, with a 16-character App Password
GMAIL_USER=kgstechwayservices@gmail.com
GMAIL_APP_PASSWORD=

# Google service account with Editor access to the sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, including the BEGIN/END lines.
# Literal \n sequences are fine, the code turns them into newlines.
GOOGLE_PRIVATE_KEY=
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

# Random secret that signs the fee-survey links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates the fee buttons in every email already sent.
FEE_LINK_SECRET=

# Base URL used in the email's fee links. Use http://localhost:3000 locally.
SITE_URL=https://kgstechway.com

# --- Existing ---
GROQ_API_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
